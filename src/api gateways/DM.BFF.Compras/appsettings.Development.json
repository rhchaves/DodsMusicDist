{

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "BffCheckout"
    }
  },
  "RabbitMqTransportOptions": {
    "Host": "localhost",
    "Port": 5672,
    "User": "dodsmusic",
    "Pass": "dodsmusic",
    "VirtualHost": "/"
  },
  "AppSettings": {
    "JwksUri": "https://localhost:5101/jwks",
    "Issuer": "https://localhost:5101",
    "Audience": "DodsMusic"
  },
  "AllowedHosts": "*",
  "CarrinhoUrl": "https://localhost:5201",
  "CatalogoUrl": "https://localhost:5301",
  "ClienteUrl": "https://localhost:5401",
  "PagamentoUrl": "https://localhost:5601",
  "PedidoUrl": "https://localhost:5701"

  //
  // Configurações salvas em 'Secrets.json'
}
