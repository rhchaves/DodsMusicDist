@using DM.Loja.MVC.Extensions
@model IEnumerable<DM.Loja.MVC.Models.ProdutoViewModel>

@{
    ViewData["Title"] = "Todos os produtos";
}

<section>
    <div>
        <div style="background-image: url(images/banners/Template.jpg); height: 100%; background-position: center; background-repeat: no-repeat; background-size: cover">
            <div class="text-center">
                <img src="~/images/banners/dodsmusic.png" />
            </div>
        </div>
        <div class="container pt-4">
            <div class="row">
                @{
                    // Lógica provisória enquanto não tiver contagem de vendas. (Depois exibir por item mais vendido).
                    @foreach (var produto in Model.OrderByDescending(p => p.QuantidadeEstoque).ThenBy(p => p.Nome))
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 h-100">
                            <a class="text-decoration-none text-dark d-block"
                               asp-controller="Catalogo" asp-action="ProdutoDetalhe" asp-route-id="@produto.Id">

                                <div href="#" class="card card-product-grid overflow-hidden">
                                    <div class="produto-img-wrapper">
                                        <img class="img-wrap" src="~/images/produtos/@produto.Imagem" alt="@produto.Nome">
                                    </div>

                                    <figcaption class="info-wrap h-75">
                                        <b class="produto-nome" title="@produto.Nome">@produto.Nome</b>
                                        <small class="card-text">
                                            @this.MensagemEstoque(produto.QuantidadeEstoque)<br />
                                            @(produto.Descricao?.Length > 80 ? produto.Descricao.Substring(0, 80) + "..." : produto.Descricao)
                                        </small>
                                    </figcaption>

                                    <div class="card-footer">
                                        <h3>@this.FormatoMoeda(produto.Valor)</h3>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>