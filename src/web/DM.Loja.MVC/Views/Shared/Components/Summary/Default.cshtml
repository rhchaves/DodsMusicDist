@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="pt-3"></div>

    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h3 id="msgRetorno" class="pt-3">Opa! Algo deu errado :(</h3>
        <div class="text-danger pt-3" asp-validation-summary="All"> </div>

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    if (TempData["Erros"] is IEnumerable<string> mensagensErro && mensagensErro.Any())
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h3 id="msgRetorno" class="pt-3">Opa! Algo deu errado :(</h3>
            <div class="text-danger pt-3" asp-validation-summary="All"> </div>

            <ul>
                @{
                    foreach (var erro in mensagensErro)
                    {
                        <li>@erro</li>
                    }
                }

            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}