@model DM.Loja.MVC.Models.UsuarioLogin

@{
    ViewData["Title"] = "Log in";
}

<h1 class="text-center mb-5">@ViewData["Title"]</h1>

<div class="row justify-content-center align-items-center min-wh-100">
    <div class="col-md-4">
        <section class="card p-4 shadow">
            <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                <h4 class="text-center">Seja bem-vindo e boas compras</h4>
                <hr />

                <vc:Summary></vc:Summary>

                <div class="form-group mb-3">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Senha"></label>
                    <input type="password" asp-for="Senha" class="form-control" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Entrar</button>
                </div>

                <div class="text-center mt-3">
                    <a asp-action="Registro" asp-controller="Identidade">
                        Criar uma conta
                    </a>
                </div>
            </form>
        </section>
    </div>
</div>
