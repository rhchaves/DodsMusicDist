{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "DMLoja"
    }
  },
  "RabbitMqTransportOptions": {
    "Host": "localhost",
    "Port": 5672,
    "User": "dodsmusic",
    "Pass": "dodsmusic",
    "VirtualHost": "/"
  },
  "AppSettings": {
    "AutenticacaoJwksUrl": "https://localhost:5101/jwks"
  },
  "AutenticacaoUrl": "https://localhost:5101",
  "CatalogoUrl": "https://localhost:5301",
  "ClienteUrl": "https://localhost:5401",
  "ComprasBffUrl": "https://localhost:5501"

  //
  // Configurações salvas em 'Secrets.json'
}
